# chat_identifier values from `uv run python -m bumpass_bot.list_chats`
CHAT_A_ID=
CHAT_B_ID=

# Set to 1 to only forward ChatA -> ChatB
ONE_WAY=

# Set to 0 to stop forwarding reactions
REACTIONS=

# Optional phone/email -> name overrides, checked before Contacts: "+12025551234=Alex,bob@example.com=Bob"
NAME_OVERRIDES=
